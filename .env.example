# === YALR Configuration ===

# Server
HOST=0.0.0.0
PORT=8080

# Admin dashboard: initial admin user (created on first start if none exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Session secret for dashboard cookies (please set a long random string)
SESSION_SECRET=please-generate-a-long-random-string

# Auth token for /metrics (please set a long random string, e.g. `openssl rand -hex 32`).
# WARNING: without a token, /metrics is accessible without auth — always set this in production!
METRICS_TOKEN=please-generate-another-random-string

# Postgres (virtual keys, provider credentials, fallback chains, sessions)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=yalr
POSTGRES_PASSWORD=yalr-secret
POSTGRES_DB=yalr

# ClickHouse (request logs & metrics)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse-secret
CLICKHOUSE_DB=yalr


# Optional: max size (bytes) of request/response bodies in the log (default 32768 = 32 KB).
# Larger bodies are truncated and marked as "truncated" in the dashboard.
# LOG_BODY_MAX_LEN=32768
